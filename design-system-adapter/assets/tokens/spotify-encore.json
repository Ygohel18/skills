{
  "$schema": "https://json.schemastore.org/component-tokens",
  "system": "spotify-encore",
  "version": "1.0",
  "tokens": {
    "color": {
      "essentialBase": "#FFFFFF",
      "essentialSubdued": "#B3B3B3",
      "essentialNegative": "#F15E6C",
      "essentialWarning": "#FFA42B",
      "essentialPositive": "#1ED760",
      "essentialAnnouncement": "#0D72EA",
      "backgroundBase": "#121212",
      "backgroundElevatedBase": "#242424",
      "backgroundHighlight": "#1A1A1A",
      "backgroundPress": "#000000",
      "textBase": "#FFFFFF",
      "textSubdued": "#A7A7A7",
      "textNegative": "#F15E6C"
