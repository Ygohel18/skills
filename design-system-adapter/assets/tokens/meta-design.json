{
  "$schema": "https://json.schemastore.org/component-tokens",
  "system": "meta-astryx",
  "version": "1.0",
  "tokens": {
    "color": {
      "blueBase": "#0866FF",
      "blueHover": "#0055D6",
      "surfacePrimary": { "light": "#FFFFFF", "dark": "#242526" },
      "surfaceSecondary": { "light": "#F0F2F5", "dark": "#18191A" },
      "textPrimary": { "light": "#050505", "dark": "#E4E6EB" },
      "textSecondary": { "light": "#65676B", "dark": "#B0B3B8" },
      "borderDivider": { "light": "#CED0D4", "dark": "#393A3B" }
    },
    "typography": {
      "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
      "headerLarge": { "fontSize": "20px", "lineHeight": "24px", "fontWeight": "700" },
      "bodyRegular": { "fontSize": "15px", "lineHeight": "20px", "fontWeight": "400" },
      "metaCaption": { "fontSize": "13px", "lineHeight": "16px", "fontWeight": "400" }
    },
    "shape": {
      "radiusSmall": "6px",
      "radiusMedium": "8px",
      "radiusLarge": "12px",
      "radiusCircle": "50%"
    },
    "spacing": {
      "baseUnit": "8px",
      "cardPadding": "12px 16px",
      "feedMaxWidth": "680px"
    },
    "shadow": {
      "cardShadow": "0 1px 2px rgba(0, 0, 0, 0.2)"
    }
  }
}
