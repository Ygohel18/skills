{
  "$schema": "https://json.schemastore.org/component-tokens",
  "system": "github-primer",
  "version": "1.0",
  "tokens": {
    "color": {
      "fgDefault": { "light": "#1F2328", "dark": "#F0F6FC" },
      "fgMuted": { "light": "#656D76", "dark": "#9198A1" },
      "fgSubtle": { "light": "#6E7781", "dark": "#7D8590" },
      "canvasDefault": { "light": "#FFFFFF", "dark": "#0D1117" },
      "canvasSubtle": { "light": "#F6F8FA", "dark": "#161B22" },
      "canvasInset": { "light": "#F6F8FA", "dark": "#010409" },
      "borderDefault": { "light": "#D0D7DE", "dark": "#30363D" },
      "borderMuted": { "light": "#D8DEE4", "dark": "#21262D" },
      "accentFg": { "light": "#0969DA", "dark": "#4493F8" },
      "accentEmphasis": { "light": "#0969DA", "dark": "#1F6FEB" },
      "successFg": { "light": "#1A7F37", "dark": "#3FB950" },
      "successEmphasis": { "light": "#1F883D", "dark": "#238636" },
      "dangerFg": { "light": "#D1242F", "dark": "#F85149" }
    },
    "typography": {
      "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif",
      "fontCode": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace",
      "titleLarge": { "fontSize": "32px", "lineHeight": "1.25", "fontWeight": "600" },
      "titleMedium": { "fontSize": "20px", "lineHeight": "1.4", "fontWeight": "600" },
      "bodyMedium": { "fontSize": "14px", "lineHeight": "1.4285", "fontWeight": "400" },
      "bodySmall": { "fontSize": "12px", "lineHeight": "1.3333", "fontWeight": "400" }
    },
    "shape": {
      "borderRadiusSmall": "3px",
      "borderRadiusMedium": "6px",
      "borderRadiusLarge": "12px",
      "borderRadiusFull": "9999px"
    },
    "spacing": {
      "space1": "4px",
      "space2": "8px",
      "space3": "16px",
      "space4": "24px",
      "space5": "32px"
    },
    "shadow": {
      "restingXSmall": "0 1px 0 rgba(31, 35, 40, 0.04)",
      "restingMedium": "0 3px 6px rgba(140, 149, 159, 0.15)",
      "floatingLarge": "0 8px 24px rgba(140, 149, 159, 0.2)"
    }
  }
}
